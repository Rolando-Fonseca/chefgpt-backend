# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_PATH=chefgpt.db

# AI — OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3-5-haiku-20241022
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024

# Optional — OpenRouter dashboard tracing
OPENROUTER_REFERER=
OPENROUTER_TITLE=

# Optional — override basics list (comma-separated)
AI_BASICS=sal,pimienta,aceite de oliva,agua
