# Server
PORT=3000
NODE_ENV=development

# Database — Neon (Postgres serverless)
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/chefgpt?sslmode=require

# AI — Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024

# Optional — override basics list (comma-separated)
AI_BASICS=sal,pimienta,aceite de oliva,agua
